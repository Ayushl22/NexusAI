# Required locally and on Vercel
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/nexusai
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-google-gemini-api-key

# Optional Gemini model routing. Defaults are suitable for deployment.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional application settings
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE=10485760

# Local server settings; Vercel supplies its own runtime values
PORT=8000
NODE_ENV=development
